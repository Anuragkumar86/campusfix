# Copy this file to ".env" and adjust. Never commit the real .env file.
# Safe development placeholders only.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string-for-real-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://campusfix:campusfix@localhost:5432/campusfix

# The exact origin of the Next.js frontend (used for CORS + CSRF trusted origins)
FRONTEND_ORIGIN=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Set both to True when serving over HTTPS (production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=28800

MEDIA_ROOT=media
# Maximum upload size in bytes (5 MB sample value - confirm before release)
MAX_UPLOAD_SIZE=5242880

# Password used by `manage.py seed_demo_data` for the sample accounts (demo only)
DEMO_PASSWORD=CampusFix@123
